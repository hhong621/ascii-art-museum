# Optional: Cloudflare cookie after visiting https://www.artic.edu in Chrome.
# DevTools → Application → Cookies → www.artic.edu → copy cf_clearance value.
# AIC_UPSTREAM_COOKIE=cf_clearance=your_value_here

# Set to 0 to disable automatic Chrome retry on 403.
# AIC_USE_BROWSER=1

# One-time local setup: npm run setup-browser (saves cookies to .aic-browser-profile/)
